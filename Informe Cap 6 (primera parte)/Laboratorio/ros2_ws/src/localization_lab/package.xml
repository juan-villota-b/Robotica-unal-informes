<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization_lab</name>
  <version>0.0.1</version>
  <description>Localization and SLAM laboratory</description>
  <maintainer email="docente@lab.com">docente</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <!-- SLAM Toolbox sustituye a cartographer_ros, que no existe para lyrical.
       Para reproducir la guía con Cartographer (Jazzy) hace falta instalar
       ros-$ROS_DISTRO-cartographer-ros aparte. -->
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
